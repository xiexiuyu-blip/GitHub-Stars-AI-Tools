{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fox-stars-lab/ai-card/v2",
  "title": "理解卡 v2（仓库 / 投喂条目 / 工具 通用）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "one_liner_zh",
    "what_it_is",
    "form",
    "primary_category",
    "capabilities",
    "problems_solved",
    "how_to_try",
    "maturity",
    "zh_friendly",
    "confidence",
    "audience",
    "risks"
  ],
  "properties": {
    "one_liner_zh": {
      "type": "string",
      "maxLength": 40,
      "description": "不超过 30 字，动词开头，说清它能帮 Fox 做成什么事；要写代码或敲命令才能用的，句子里直接说明。已弃用 / 已清空 / 已迁移的以「【已停更】」「【已弃用】」「【已清空】」开头"
    },
    "what_it_is": {
      "type": "string",
      "maxLength": 160,
      "description": "不超过 120 字、不超过 3 句：①它是什么、解决什么事；②用它的前提（装什么、要不要 API Key、花不花钱、什么系统）；③最大的限制。不列功能清单，不写版本号和数量"
    },
    "form": {
      "enum": [
        "app",
        "cli",
        "skill",
        "mcp",
        "api",
        "library",
        "service",
        "collection",
        "other"
      ]
    },
    "audience": {
      "enum": [
        "business",
        "mixed",
        "developer"
      ],
      "description": "business=不会代码也能用；mixed=要装软件或改配置，但不用写代码；developer=必须写代码或敲命令才能用"
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "macos",
          "windows",
          "linux",
          "web",
          "ios",
          "android",
          "cross"
        ]
      },
      "maxItems": 5
    },
    "primary_category": {
      "type": "string",
      "description": "taxonomy_seed.json 中的 slug"
    },
    "secondary_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 2
    },
    "capabilities": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name_zh"
        ],
        "properties": {
          "name_zh": {
            "type": "string",
            "maxLength": 24,
            "description": "动宾短语，不以「支持」「提供」「通过」开头，如“把长视频剪成短视频”；3 到 5 条，每条是不同的事"
          },
          "evidence_line": {
            "type": "integer"
          }
        }
      }
    },
    "problems_solved": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 40,
        "description": "用「我想……」的口吻写业务场景，不以「需要」开头，如“我想批量给小红书配图”"
      }
    },
    "use_when": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 50,
        "description": "什么时机该想起它；意思不能和 problems_solved 重复，想不出不重复的就少写"
      },
      "maxItems": 3
    },
    "not_for": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 50,
        "description": "哪类人、哪种情况不要用"
      },
      "maxItems": 2
    },
    "how_to_try": {
      "type": "string",
      "maxLength": 300,
      "description": "最短上手路径（安装命令/入口）"
    },
    "integrates_with": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      },
      "maxItems": 8,
      "description": "如 Claude Code、Codex、Obsidian"
    },
    "alternatives_hint": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "description": "owner/repo 或产品名，后续用向量 + 图谱校验"
    },
    "inspiration_for_fox": {
      "type": "string",
      "maxLength": 80,
      "description": "可以借鉴的做法；不出现“Fox”二字，直接对“你”说；没有就留空"
    },
    "maturity": {
      "enum": [
        "experimental",
        "usable",
        "mature",
        "stale"
      ]
    },
    "zh_friendly": {
      "type": "boolean"
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 50,
        "description": "用之前要知道的坑：门槛（要程序员 / 命令行）、费用（付费 API Key）、隐私、合规（爬取 / 绕过防护 / 逆向 / 账号池）、只支持某系统、只有英文、早期测试版、不稳定、已弃用或迁移；材料里实在没有依据，就写“README 没写限制，需要自己试”"
      },
      "maxItems": 3
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "keywords": {
      "type": "array",
      "maxItems": 10,
      "description": "Fox 会拿来搜索的词，以中文为主，再加 2 到 3 个常见的英文名",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 20
      }
    },
    "scenario_tags": {
      "type": "array",
      "maxItems": 3,
      "description": "业务场景 slug；没有证据就输出 []",
      "items": {
        "type": "string"
      }
    },
    "scenario_evidence": {
      "type": "object",
      "description": "每个 scenario_tags 里的 slug 对应一句 README 或 GitHub 简介里的原话（不超过 25 字，逐字复制）；找不到原话的标签不要选"
    }
  }
}
